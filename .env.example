# The /api/chat route needs at least one of these free-tier keys.
#
# Gemini (used by default when set) — free tier, no card required:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — free tier, used as the fallback provider:
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: force a specific provider ("gemini" or "groq").
# Defaults to gemini if GEMINI_API_KEY is set, otherwise groq.
# AI_PROVIDER=gemini

# Optional: override the default model for each provider.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────
# Supabase — optional. Powers sign-in and saved chat history. Without these,
# the app still works, just without auth or persistence (same as before).
# Dashboard: https://supabase.com/dashboard -> your project -> Settings -> API
# ─────────────────────────────────────────────────────────────────────────
# Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# Settings -> API -> "Publishable key" (new dashboards) or "anon public" under
# Legacy API keys (older dashboards) — NOT the secret/service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: daily message caps used by the Postgres-backed rate limiter
# (see supabase/schema.sql). Only enforced when Supabase is configured.
# Defaults: 5/day anonymous, 15/day signed-in.
# RATE_LIMIT_ANONYMOUS_PER_DAY=5
# RATE_LIMIT_AUTHENTICATED_PER_DAY=15
